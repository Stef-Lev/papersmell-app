{
  "expo": {
    "name": "PaperSmell",
    "slug": "papersmell-mobile",
    "scheme": "papersmell",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "backgroundColor": "#eff7f6",
    "primaryColor": "#377d80",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#eff7f6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.papersmellmobile"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PaperSmell to scan book barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PaperSmell to select a profile photo.",
          "cameraPermission": "Allow PaperSmell to take a profile photo.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
